# Copy to .env.local and restart the dev server (Expo only reads env at startup).
# EXPO_PUBLIC_ vars are inlined into the client bundle — never put a secret key here.

# Supabase -> Project Settings -> API Keys
EXPO_PUBLIC_SUPABASE_URL=https://eakkqpjuphwyfvwsrili.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable__DNvTCnz3jOoRn5VmIlqtA_CmI3VHpd

# Google Cloud console -> Credentials -> OAuth 2.0 Client IDs
# Web client ID: also pasted into Supabase's Google provider. Android verifies against it too.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# iOS client ID: also drives the iOS URL scheme in app.config.ts.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
