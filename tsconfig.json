{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // node --test type-strips the test file, so it imports `./aal.ts` with the real extension.
    "allowImportingTsExtensions": true,
    // Expo's base config leaves `types` unset; naming node here is what pulls in `node:test`.
    "types": ["node"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "tools/**"
  ]
}
