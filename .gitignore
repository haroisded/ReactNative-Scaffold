# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS artifacts
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.pem

# local env files — the example stays tracked, everything else never lands in git
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code local overrides (per-machine permission grants)
.claude/settings.local.json

# every directory under .claude/ — vendored docs (context/), commit-message handoffs
# (commit-history/, context-policy.md §2), acceptance tests (tests/), /teach notes, references —
# local to each machine, never committed. Files (settings.json) stay tracked, and so does
# instruction_mds/: the project's conventions, the one directory here that is shared.
.claude/*/
!.claude/instruction_mds/

# headroom wrap state (live pid, port, env-var ownership) — per-machine, never shared
.claude/.headroom_wrap_*

# Supabase CLI (link state, local stack scratch)
supabase/.temp/
supabase/.branches/

# graphify knowledge graph output
graphify-out/
